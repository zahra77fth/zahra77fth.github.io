generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  DISCOVERED
  ELIGIBLE
  NEEDS_CLARIFICATION
  EXCLUDED
  EXPIRED
  DUPLICATE
}

enum ApplicationState {
  QUEUED
  DOCUMENTS_READY
  APPLYING
  SUBMITTED_VERIFIED
  SUBMISSION_UNCERTAIN
  NEEDS_ACTION
  RETRY_PENDING
  FAILED
  EXPIRED
  SKIPPED
  DUPLICATE
  APPLIED_MANUALLY
  NOT_INTERESTED
}

enum ManualReason {
  CAPTCHA
  MFA
  LOGIN_REQUIRED
  UNSUPPORTED_ATS
  SITE_RESTRICTION
  AUTOMATION_FAILURE
  UNKNOWN_SCREENING_QUESTION
  HUMAN_VERIFICATION
  SUBMISSION_UNCERTAIN
  MISSING_CANDIDATE_INFO
  AUTO_SUBMIT_DISABLED
  NO_APPLICATION_URL
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model CandidateProfile {
  id             String    @id @default("singleton")
  sourceFile     String?
  sourceSha256   String?
  rawText        String?
  extracted      Json
  data           Json
  approvedAt     DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())
}

model ScreeningAnswer {
  id          String    @id @default(cuid())
  questionKey String    @unique
  question    String
  answer      String?
  verified    Boolean   @default(false)
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Secret {
  key        String   @id
  ciphertext String
  updatedAt  DateTime @updatedAt
}

model Source {
  id            String    @id
  kind          String
  name          String
  enabled       Boolean   @default(true)
  coverage      String    @default("UNKNOWN")
  lastRunAt     DateTime?
  lastStatus    String?
  lastError     String?
  lastJobCount  Int       @default(0)
  lastMatchCount Int      @default(0)
  notes         String?
  updatedAt     DateTime  @updatedAt
}

model Job {
  id               String       @id @default(cuid())
  sourceId         String
  externalId       String
  canonicalUrl     String       @unique
  applyUrl         String?
  fingerprint      String
  company          String
  title            String
  country          String?
  city             String?
  locationRaw      String?
  remotePolicy     String       @default("UNKNOWN")
  techStack        String[]
  descriptionText  String
  descriptionLang  String?
  postedAt         DateTime?
  atsKind          String?
  status           JobStatus    @default(DISCOVERED)
  matchScore       Int?
  matchExplanation Json?
  eligibilityNote  String?
  duplicateOfId    String?
  firstSeenAt      DateTime     @default(now())
  lastSeenAt       DateTime     @default(now())
  expiredAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  application      Application?

  @@unique([sourceId, externalId])
  @@index([fingerprint])
  @@index([status])
  @@index([country])
}

model Application {
  id                String           @id @default(cuid())
  jobId             String           @unique
  job               Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  state             ApplicationState @default(QUEUED)
  priority          Int              @default(0)
  attemptCount      Int              @default(0)
  nextAttemptAt     DateTime?
  lockedBy          String?
  lockedAt          DateTime?
  manualReason      ManualReason?
  manualDetail      String?
  resumePdfPath     String?
  resumeDocxPath    String?
  coverPdfPath      String?
  coverDocxPath     String?
  coverTxtPath      String?
  coverLanguage     String?
  confirmationRef   String?
  submittedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  transitions       StateTransition[]
  attempts          ApplicationAttempt[]

  @@index([state])
}

model ApplicationAttempt {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  attemptNumber   Int
  idempotencyKey  String      @unique
  workerId        String
  adapter         String?
  startedAt       DateTime    @default(now())
  submitClickedAt DateTime?
  finishedAt      DateTime?
  outcome         String?
  error           String?
  screenshotPath  String?
  htmlPath        String?
  evidence        Json?
  log             Json?

  @@index([applicationId])
}

model StateTransition {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromState     ApplicationState?
  toState       ApplicationState
  attemptNumber Int         @default(0)
  reason        String
  error         String?
  evidence      Json?
  workerId      String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@index([createdAt])
}

model Event {
  id        String   @id @default(cuid())
  type      String
  jobId     String?
  runId     String?
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([jobId])
}

model PipelineRun {
  id           String    @id @default(cuid())
  trigger      String
  status       String    @default("RUNNING")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  stats        Json?
  error        String?
}

model NotificationLog {
  id        String   @id @default(cuid())
  dedupeKey String   @unique
  channel   String
  subject   String
  status    String
  error     String?
  createdAt DateTime @default(now())
}
