# --- Required ---
DATABASE_URL=postgresql://autoapply:autoapply@localhost:5432/autoapply
REDIS_URL=redis://localhost:6379
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Session signing secret. Generate the same way.
SESSION_SECRET=

# --- Paths ---
# Where generated documents, screenshots and evidence are stored (outside the repo recommended).
STORAGE_DIR=./storage
# Optional override for Desktop detection (e.g. /Users/you/Desktop)
DESKTOP_DIR=

# --- Safety ---
# Real submissions require BOTH this flag and the "Automatic submission" setting in the dashboard.
AUTHORIZE_REAL_SUBMISSIONS=false
WORKER_CONCURRENCY_APPLY=1
WORKER_CONCURRENCY_PROCESS=4
HEADLESS=true

# --- LLM (optional; OpenAI-compatible). Can also be stored encrypted from Settings. ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# --- Email (optional). SMTP or Gmail OAuth2 ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
NOTIFY_TO=
NOTIFY_FROM=
DASHBOARD_URL=http://localhost:3000
